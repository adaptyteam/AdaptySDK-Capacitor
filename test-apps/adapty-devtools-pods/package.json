{
  "name": "adapty-capacitor-devtools-pods",
  "version": "1.0.0",
  "description": "Adapty capacitor devtools on CocoaPods (iOS)",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile",
    "adapty",
    "devtools",
    "cocoapods"
  ],
  "scripts": {
    "credentials": "node ../../scripts/credentials.mjs",
    "preinstall": "cd ../../ && yarn install && yarn build",
    "postinstall": "yarn credentials",
    "start": "vite",
    "build": "vite build",
    "tsc": "tsc --noEmit",
    "wvd": "WVD_APP_ROOT=. node ../../examples/adapty-devtools/scripts/webview-driver.mjs",
    "update-cap-config": "yarn cap copy ios && yarn cap sync ios",
    "update-native-modules": "cd ios/App && pod update --repo-update Adapty AdaptyUI AdaptyPlugin && cd ../.. && yarn run update-cap-config",
    "ios": "yarn build && yarn cap run ios",
    "dev:ios": "yarn cap run ios --live-reload --no-sync --host 192.168.1.76 --port 5173"
  },
  "dependencies": {
    "@adapty/capacitor": "link:../..",
    "@capacitor/app": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/toast": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.2"
  },
  "author": "",
  "license": "MIT"
}
